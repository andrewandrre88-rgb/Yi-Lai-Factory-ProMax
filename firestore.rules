rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Catch-All Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isServerTimestamp(ts) {
      return ts is timestamp
        && (ts == request.time
            || (ts >= request.time - duration.value(30, 's')
                && ts <= request.time + duration.value(30, 's')));
    }

    // Token-only verified primary admin check (zero DB reads for safe allow list queries)
    function isPrimaryAdmin() {
      return isSignedIn()
        && 'email_verified' in request.auth.token
        && request.auth.token.email_verified == true
        && 'email' in request.auth.token
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'vvx71336@gmail.com';
    }

    // Full admin check for single-document reads and mutations
    function isAdmin() {
      return isPrimaryAdmin()
        || (isSignedIn()
            && 'email_verified' in request.auth.token
            && request.auth.token.email_verified == true
            && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidProductCategory(cat) {
      return cat in [
        'trigger-sprayers',
        'mini-triggers',
        'foam-triggers',
        'lotion-pumps',
        'fine-mist-sprayers',
        'bottle-caps-closures'
      ];
    }

    function hasAllowedSocialPrefix(url) {
      return (url.size() >= 7 && (url.lower()[0:7] == 'http://' || url.lower()[0:7] == 'mailto:'))
        || (url.size() >= 8 && url.lower()[0:8] == 'https://');
    }

    function isValidSocialUrl(url) {
      return url is string
        && url.size() <= 300
        && (url == '' || hasAllowedSocialPrefix(url));
    }

    function isValidSocialLinkItem(url) {
      return url is string
        && url.size() >= 1
        && url.size() <= 300
        && hasAllowedSocialPrefix(url);
    }

    function isValidSocialAccountList(listVal) {
      return listVal is list
        && listVal.size() <= 5
        && (listVal.size() < 1 || isValidSocialLinkItem(listVal[0]))
        && (listVal.size() < 2 || isValidSocialLinkItem(listVal[1]))
        && (listVal.size() < 3 || isValidSocialLinkItem(listVal[2]))
        && (listVal.size() < 4 || isValidSocialLinkItem(listVal[3]))
        && (listVal.size() < 5 || isValidSocialLinkItem(listVal[4]));
    }

    function isValidSocialFieldValue(val) {
      return isValidSocialAccountList(val) || isValidSocialUrl(val);
    }

    function isValidSocialLinks(links) {
      return links is map
        && links.keys().hasAll([
          'facebook', 'instagram', 'tiktok', 'youtube',
          'linkedin', 'x', 'snapchat', 'pinterest', 'gmail'
        ])
        && links.keys().hasOnly([
          'facebook', 'instagram', 'tiktok', 'youtube',
          'linkedin', 'x', 'snapchat', 'pinterest', 'gmail'
        ])
        && isValidSocialFieldValue(links.facebook)
        && isValidSocialFieldValue(links.instagram)
        && isValidSocialFieldValue(links.tiktok)
        && isValidSocialFieldValue(links.youtube)
        && isValidSocialFieldValue(links.linkedin)
        && isValidSocialFieldValue(links.x)
        && isValidSocialFieldValue(links.snapchat)
        && isValidSocialFieldValue(links.pinterest)
        && isValidSocialFieldValue(links.gmail);
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'categoryId', 'slug', 'model', 'neckFinish', 'dosage', 'closureStyle',
          'springType', 'moq', 'materials', 'leadTime', 'applications', 'description',
          'features', 'galleryUrls', 'galleryLabels', 'status', 'authorUid',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'categoryId', 'slug', 'model', 'neckFinish', 'dosage', 'closureStyle',
          'springType', 'moq', 'materials', 'leadTime', 'applications', 'description',
          'features', 'galleryUrls', 'galleryLabels', 'status', 'socialLinks', 'authorUid',
          'createdAt', 'updatedAt'
        ])
        && data.categoryId is string && isValidProductCategory(data.categoryId)
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 80 && data.slug.matches('^[a-zA-Z0-9_\\-]+$')
        && data.model is string && data.model.size() >= 1 && data.model.size() <= 140
        && data.neckFinish is string && data.neckFinish.size() >= 1 && data.neckFinish.size() <= 80
        && data.dosage is string && data.dosage.size() >= 1 && data.dosage.size() <= 80
        && data.closureStyle is string && data.closureStyle.size() >= 1 && data.closureStyle.size() <= 120
        && data.springType is string && data.springType.size() >= 1 && data.springType.size() <= 120
        && data.moq is string && data.moq.size() >= 1 && data.moq.size() <= 60
        && data.materials is string && data.materials.size() >= 1 && data.materials.size() <= 200
        && data.leadTime is string && data.leadTime.size() >= 1 && data.leadTime.size() <= 60
        && data.applications is string && data.applications.size() >= 1 && data.applications.size() <= 300
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 2000
        && data.features is list && data.features.size() >= 1 && data.features.size() <= 10 && data.features[0] is string && data.features[0].size() <= 240
        && data.galleryUrls is list && data.galleryUrls.size() >= 1 && data.galleryUrls.size() <= 6 && data.galleryUrls[0] is string && data.galleryUrls[0].size() <= 100000
        && data.galleryLabels is list && data.galleryLabels.size() == data.galleryUrls.size() && data.galleryLabels[0] is string && data.galleryLabels[0].size() <= 120
        && data.status is string && data.status in ['active', 'archived']
        && (!('socialLinks' in data) || isValidSocialLinks(data.socialLinks))
        && data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBlogCategory(cat) {
      return cat in [
        'Engineering',
        'Manufacturing',
        'Quality Control',
        'Packaging Trends',
        'Export & Logistics'
      ];
    }

    function isValidBlogPost(data) {
      return data.keys().hasAll([
          'slug', 'title', 'excerpt', 'content', 'category', 'coverImage',
          'authorName', 'readTime', 'tags', 'status', 'publishedAt',
          'authorUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'slug', 'title', 'excerpt', 'content', 'category', 'coverImage',
          'authorName', 'readTime', 'tags', 'status', 'publishedAt', 'socialLinks',
          'authorUid', 'createdAt', 'updatedAt'
        ])
        && data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 100 && data.slug.matches('^[a-zA-Z0-9_\\-]+$')
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 180
        && data.excerpt is string && data.excerpt.size() >= 1 && data.excerpt.size() <= 400
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 12000
        && data.category is string && isValidBlogCategory(data.category)
        && data.coverImage is string && data.coverImage.size() >= 1 && data.coverImage.size() <= 100000
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 80
        && data.readTime is string && data.readTime.size() >= 1 && data.readTime.size() <= 40
        && data.tags is list && data.tags.size() <= 8 && (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 40))
        && data.status is string && data.status in ['published', 'draft']
        && data.publishedAt is string && data.publishedAt.size() >= 1 && data.publishedAt.size() <= 40
        && (!('socialLinks' in data) || isValidSocialLinks(data.socialLinks))
        && data.authorUid is string && data.authorUid.size() >= 1 && data.authorUid.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSiteConfig(data) {
      return data.keys().hasAll(['seeded', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['seeded', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.seeded is bool
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSocialSettings(data) {
      return data.keys().hasAll([
          'facebook', 'instagram', 'tiktok', 'youtube',
          'linkedin', 'x', 'snapchat', 'pinterest', 'gmail',
          'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'facebook', 'instagram', 'tiktok', 'youtube',
          'linkedin', 'x', 'snapchat', 'pinterest', 'gmail',
          'updatedBy', 'createdAt', 'updatedAt'
        ])
        && isValidSocialFieldValue(data.facebook)
        && isValidSocialFieldValue(data.instagram)
        && isValidSocialFieldValue(data.tiktok)
        && isValidSocialFieldValue(data.youtube)
        && isValidSocialFieldValue(data.linkedin)
        && isValidSocialFieldValue(data.x)
        && isValidSocialFieldValue(data.snapchat)
        && isValidSocialFieldValue(data.pinterest)
        && isValidSocialFieldValue(data.gmail)
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt'])
        && data.keys().hasOnly(['email', 'role', 'createdAt'])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.role is string && data.role == 'admin'
        && data.createdAt is timestamp;
    }

    function isValidFaqItem(item) {
      return item is map
        && item.keys().hasAll(['id', 'question', 'answer'])
        && item.keys().hasOnly(['id', 'question', 'answer'])
        && item.id is string && item.id.size() >= 1 && item.id.size() <= 80
        && item.question is string && item.question.size() >= 1 && item.question.size() <= 300
        && item.answer is string && item.answer.size() >= 1 && item.answer.size() <= 1000;
    }

    function isValidSeoSettings(data) {
      return data.keys().hasAll([
          'siteTitle', 'metaDescription', 'keywords', 'canonicalUrl',
          'ogTitle', 'ogDescription', 'ogImage', 'robotsIndex',
          'googleVerification', 'bingVerification', 'yandexVerification', 'baiduVerification',
          'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'siteTitle', 'metaDescription', 'keywords', 'canonicalUrl',
          'ogTitle', 'ogDescription', 'ogImage', 'robotsIndex',
          'googleVerification', 'bingVerification', 'yandexVerification', 'baiduVerification',
          'autoApplyToNewContent', 'enableFaqSchema', 'enableItemListSchema',
          'enableHreflangTags', 'indexNowKey', 'trackedKeywords', 'faqItems',
          'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.siteTitle is string && data.siteTitle.size() >= 1 && data.siteTitle.size() <= 120
        && data.metaDescription is string && data.metaDescription.size() >= 1 && data.metaDescription.size() <= 320
        && data.keywords is list && data.keywords.size() <= 30 && (data.keywords.size() == 0 || (data.keywords[0] is string && data.keywords[0].size() <= 60))
        && data.canonicalUrl is string && data.canonicalUrl.size() <= 300 && (data.canonicalUrl == '' || data.canonicalUrl.lower().matches('^https?://.*'))
        && data.ogTitle is string && data.ogTitle.size() <= 120
        && data.ogDescription is string && data.ogDescription.size() <= 320
        && data.ogImage is string && data.ogImage.size() <= 100000
        && data.robotsIndex is bool
        && data.googleVerification is string && data.googleVerification.size() <= 120
        && data.bingVerification is string && data.bingVerification.size() <= 120
        && data.yandexVerification is string && data.yandexVerification.size() <= 120
        && data.baiduVerification is string && data.baiduVerification.size() <= 120
        && (!('autoApplyToNewContent' in data) || data.autoApplyToNewContent is bool)
        && (!('enableFaqSchema' in data) || data.enableFaqSchema is bool)
        && (!('enableItemListSchema' in data) || data.enableItemListSchema is bool)
        && (!('enableHreflangTags' in data) || data.enableHreflangTags is bool)
        && (!('indexNowKey' in data) || (data.indexNowKey is string && data.indexNowKey.size() <= 64))
        && (!('trackedKeywords' in data) || (data.trackedKeywords is list && data.trackedKeywords.size() <= 20 && (data.trackedKeywords.size() == 0 || (data.trackedKeywords[0] is string && data.trackedKeywords[0].size() <= 80))))
        && (!('faqItems' in data) || (data.faqItems is list && data.faqItems.size() <= 12 && (data.faqItems.size() == 0 || isValidFaqItem(data.faqItems[0]))))
        && data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection: products ---
    match /products/{productId} {
      allow get: if isValidId(productId) && ((resource != null && existing().status == 'active') || isAdmin());
      allow list: if resource.data.status == 'active' || isPrimaryAdmin();

      allow create: if isSignedIn()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().authorUid == request.auth.uid
        && isServerTimestamp(incoming().createdAt)
        && isServerTimestamp(incoming().updatedAt)
        && isAdmin();

      allow update: if isSignedIn()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && isServerTimestamp(incoming().updatedAt)
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'categoryId', 'slug', 'model', 'neckFinish', 'dosage', 'closureStyle',
          'springType', 'moq', 'materials', 'leadTime', 'applications', 'description',
          'features', 'galleryUrls', 'galleryLabels', 'status', 'socialLinks', 'updatedAt'
        ]);

      allow delete: if isSignedIn()
        && isValidId(productId)
        && isAdmin();
    }

    // --- Collection: blogPosts ---
    match /blogPosts/{postId} {
      allow get: if isValidId(postId) && ((resource != null && existing().status == 'published') || isAdmin());
      allow list: if resource.data.status == 'published' || isPrimaryAdmin();

      allow create: if isSignedIn()
        && isValidId(postId)
        && isValidBlogPost(incoming())
        && incoming().authorUid == request.auth.uid
        && isServerTimestamp(incoming().createdAt)
        && isServerTimestamp(incoming().updatedAt)
        && isAdmin();

      allow update: if isSignedIn()
        && isValidId(postId)
        && isValidBlogPost(incoming())
        && incoming().authorUid == existing().authorUid
        && incoming().createdAt == existing().createdAt
        && isServerTimestamp(incoming().updatedAt)
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'slug', 'title', 'excerpt', 'content', 'category', 'coverImage',
          'authorName', 'readTime', 'tags', 'status', 'publishedAt', 'socialLinks', 'updatedAt'
        ]);

      allow delete: if isSignedIn()
        && isValidId(postId)
        && isAdmin();
    }

    // --- Collection: siteConfig ---
    match /siteConfig/{configId} {
      allow get: if isValidId(configId);
      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(configId)
        && isValidSiteConfig(incoming())
        && incoming().updatedBy == request.auth.uid
        && isServerTimestamp(incoming().createdAt)
        && isServerTimestamp(incoming().updatedAt)
        && isAdmin();

      allow update: if isSignedIn()
        && isValidId(configId)
        && isValidSiteConfig(incoming())
        && incoming().createdAt == existing().createdAt
        && isServerTimestamp(incoming().updatedAt)
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'seeded', 'updatedBy', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(configId) && isAdmin();
    }

    // --- Collection: admins ---
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isPrimaryAdmin();
      allow create: if isPrimaryAdmin()
        && isValidId(adminUid)
        && isValidAdminUser(incoming())
        && isServerTimestamp(incoming().createdAt);
      allow update: if false;
      allow delete: if isPrimaryAdmin() && isValidId(adminUid);
    }

    // --- Collection: socialSettings ---
    match /socialSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(settingId)
        && isValidSocialSettings(incoming())
        && incoming().updatedBy == request.auth.uid
        && isServerTimestamp(incoming().createdAt)
        && isServerTimestamp(incoming().updatedAt)
        && isAdmin();

      allow update: if isSignedIn()
        && isValidId(settingId)
        && isValidSocialSettings(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == existing().createdAt
        && isServerTimestamp(incoming().updatedAt)
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'facebook', 'instagram', 'tiktok', 'youtube',
          'linkedin', 'x', 'snapchat', 'pinterest', 'gmail',
          'updatedBy', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(settingId) && isAdmin();
    }

    // --- Collection: seoSettings ---
    match /seoSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(settingId)
        && isValidSeoSettings(incoming())
        && incoming().updatedBy == request.auth.uid
        && isServerTimestamp(incoming().createdAt)
        && isServerTimestamp(incoming().updatedAt)
        && isAdmin();

      allow update: if isSignedIn()
        && isValidId(settingId)
        && isValidSeoSettings(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == existing().createdAt
        && isServerTimestamp(incoming().updatedAt)
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'siteTitle', 'metaDescription', 'keywords', 'canonicalUrl',
          'ogTitle', 'ogDescription', 'ogImage', 'robotsIndex',
          'googleVerification', 'bingVerification', 'yandexVerification', 'baiduVerification',
          'autoApplyToNewContent', 'enableFaqSchema', 'enableItemListSchema',
          'enableHreflangTags', 'indexNowKey', 'trackedKeywords', 'faqItems',
          'updatedBy', 'updatedAt'
        ]);

      allow delete: if isSignedIn() && isValidId(settingId) && isAdmin();
    }
  }
}
